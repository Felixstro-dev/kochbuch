# Kochbuch – Beispielkonfiguration
# Kopieren nach `.env` und anpassen. Alle Werte sind optional.

# --- Allgemein ------------------------------------------------------------
APP_NAME=Kochbuch
ENVIRONMENT=production
LOG_LEVEL=INFO
DATA_DIR=/data
FRONTEND_DIR=/app/frontend/build

# Pflicht in Produktion: langer, zufälliger Wert.
SECRET_KEY=bitte-mit-openssl-rand-hex-32-ersetzen
# Standard-Admin beim ersten Start (optional, alternativ Setup-Seite).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Cookies über HTTPS versenden und nur an die eigene Domain binden.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Netzwerk / Home Assistant -------------------------------------------
CORS_ORIGINS=
FRAME_ANCESTORS='self'
# true = Lesezugriff ohne Login (z. B. für öffentliche Einbettung).
EMBED_PUBLIC=false

# --- Quellen --------------------------------------------------------------
ENABLED_PROVIDERS=chefkoch,web,local
ALLOW_PRIVATE_URLS=false

# --- Robuster Abruf (Ergänzung C) ----------------------------------------
# Alles standardmäßig aus. Stufe 1 ist immer aktiv.
# Proxy für Suche, Rezepte und Bilder, z. B. socks5://user:pass@host:1080
FETCH_PROXY_URL=
FETCH_PROXY_FOR_IMAGES=true
# Letzte Eskalationsstufe für HTML-Seiten mit Cloudflare & Co.
FLARESOLVERR_URL=
FLARESOLVERR_TIMEOUT=60
FETCH_MAX_RETRIES=3
FETCH_TIMEOUT=15
FETCH_MIN_INTERVAL=0.4
FETCH_CIRCUIT_THRESHOLD=4
FETCH_CIRCUIT_COOLDOWN=60
# Nur wirksam, wenn das optionale Extra `curl_cffi` installiert ist.
FETCH_BROWSER_IMPERSONATION=true

# --- Caching --------------------------------------------------------------
SEARCH_CACHE_SECONDS=600
RECIPE_STALE_DAYS=7
